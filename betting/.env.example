# Copy this file to ".env" (same folder) and paste your keys in.
# The .env file is ignored by git, so your keys never get committed.
# Lines starting with # are ignored. No quotes needed, no spaces around the =.

# From https://api-football.com — gives injuries, fast results and player data.
API_FOOTBALL_KEY=paste-your-key-here

# Optional. From https://the-odds-api.com — live bookmaker prices.
ODDS_API_KEY=
